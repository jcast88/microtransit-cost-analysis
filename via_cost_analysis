# Capacity scenarios ----

via_capacity_scenarios <- via_service_levels_cost %>%
  dplyr::select(
    system,
    veh_hours_per_day,
    contract_daily_cost
  ) %>%
  dplyr::left_join(
    via_trip_characteristics %>%
      dplyr::select(
        system,
        observed_average_vehicle_occupancy =
          average_vehicle_occupancy,
        p75_trip_duration_minutes
      ),
    by = "system"
  ) %>%
  dplyr::mutate(
    planning_avo = 4,
    
    inter_trip_buffer_minutes =
      buffer_mins,
    
    rough_daily_passenger_capacity =
      (
        veh_hours_per_day * 60 /
          (
            p75_trip_duration_minutes +
              inter_trip_buffer_minutes
          )
      ) * planning_avo
  ) %>%
  tidyr::crossing(
    utilization_level =
      via_capacity_levels
  ) %>%
  dplyr::mutate(
    passengers_at_utilization =
      rough_daily_passenger_capacity *
      utilization_level,
    
    cost_per_passenger =
      dplyr::if_else(
        passengers_at_utilization > 0,
        contract_daily_cost /
          passengers_at_utilization,
        NA_real_
      )
  ) %>%
  dplyr::arrange(
    system,
    utilization_level
  )

