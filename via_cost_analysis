# Helpers ----

col_or <- function(df, col_name, default) {
  if (col_name %in% names(df)) {
    df[[col_name]]
  } else {
    rep(default, nrow(df))
  }
}

safe_num <- function(x) {
  suppressWarnings(as.numeric(x))
}

parse_via_timestamp <- function(x) {
  x <- stringr::str_trim(as.character(x))
  x[x == ""] <- NA_character_
  
  suppressWarnings(
    lubridate::parse_date_time(
      x,
      orders = c(
        "Y-m-d H:M:S",
        "Y-m-d H:M",
        "Y/m/d H:M:S",
        "Y/m/d H:M",
        "m/d/Y H:M:S",
        "m/d/Y H:M",
        "m/d/Y I:M:S p",
        "m/d/Y I:M p",
        "Y-m-d",
        "Y/m/d",
        "m/d/Y"
      ),
      tz = "America/Los_Angeles",
      quiet = TRUE
    )
  )
}

via_quantile_or_na <- function(x, p) {
  x <- x[!is.na(x)]
  
  if (length(x) == 0) {
    NA_real_
  } else {
    as.numeric(stats::quantile(x, p, type = 7))
  }
}

via_min_or_na <- function(x) {
  if (all(is.na(x))) NA_real_ else min(x, na.rm = TRUE)
}

via_mean_or_na <- function(x) {
  if (length(x) == 0 || all(is.na(x))) {
    NA_real_
  } else {
    mean(x, na.rm = TRUE)
  }
}

via_median_or_na <- function(x) {
  if (length(x) == 0 || all(is.na(x))) {
    NA_real_
  } else {
    median(x, na.rm = TRUE)
  }
}

via_sum_or_na <- function(x) {
  if (length(x) == 0 || all(is.na(x))) {
    NA_real_
  } else {
    sum(x, na.rm = TRUE)
  }
}

via_max_or_na <- function(x) {
  if (length(x) == 0 || all(is.na(x))) {
    NA_real_
  } else {
    max(x, na.rm = TRUE)
  }
}

via_min_date_or_na <- function(x) {
  x <- x[!is.na(x)]
  if (length(x) == 0) as.Date(NA) else min(x)
}

via_max_date_or_na <- function(x) {
  x <- x[!is.na(x)]
  if (length(x) == 0) as.Date(NA) else max(x)
}

via_hour_label <- function(x) {
  labels <- format(
    as.POSIXct(
      paste0("2000-01-01 ", sprintf("%02d", x), ":00:00"),
      tz = "America/Los_Angeles"
    ),
    "%I %p"
  )
  
  sub("^0", "", labels)
}

first_service_day <- function(month_start) {
  month_end <- lubridate::ceiling_date(month_start, "month") - lubridate::days(1)
  dates <- seq(month_start, month_end, by = "day")
  min(dates[lubridate::wday(dates, week_start = 1) <= 5])
}

last_service_day <- function(month_start) {
  month_end <- lubridate::ceiling_date(month_start, "month") - lubridate::days(1)
  dates <- seq(month_start, month_end, by = "day")
  max(dates[lubridate::wday(dates, week_start = 1) <= 5])
}

