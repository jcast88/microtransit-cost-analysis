# Complete-month periods ----
# A month is retained when the file covers the first and last scheduled
# weekday of that month. Internal months are therefore retained even when
# a service day has no requests. Daily zero-request service days are added
# later from the service calendar.

via_date_coverage <- via_standardized %>%
  dplyr::group_by(system) %>%
  dplyr::summarise(
    first_request_date = min(request_date),
    last_request_date = max(request_date),
    .groups = "drop"
  )

via_complete_months <- via_date_coverage %>%
  dplyr::rowwise() %>%
  dplyr::mutate(
    candidate_month = list(
      seq(
        lubridate::floor_date(first_request_date, "month"),
        lubridate::floor_date(last_request_date, "month"),
        by = "month"
      )
    )
  ) %>%
  dplyr::ungroup() %>%
  tidyr::unnest(candidate_month) %>%
  dplyr::mutate(
    first_scheduled_day = as.Date(
      purrr::map_dbl(candidate_month, ~ as.numeric(first_service_day(.x))),
      origin = "1970-01-01"
    ),
    last_scheduled_day = as.Date(
      purrr::map_dbl(candidate_month, ~ as.numeric(last_service_day(.x))),
      origin = "1970-01-01"
    ),
    complete_month =
      first_request_date <= first_scheduled_day &
      last_request_date >= last_scheduled_day
  ) %>%
  dplyr::filter(
    complete_month |
      (system == "Southeastern SD" &
         candidate_month == lubridate::floor_date(last_request_date, "month"))
  ) %>%
  dplyr::filter(
    (system == "El Cajon" &
       candidate_month >= as.Date("2025-07-01") &
       candidate_month <= as.Date("2026-06-01")) |
      (system == "Southeastern SD" &
         candidate_month >= as.Date("2026-01-01"))
  ) %>%
  dplyr::transmute(
    system,
    year_month = as.Date(candidate_month)
  )

if (nrow(via_complete_months) == 0) {
  stop(
    paste(
      "No complete Via analysis months were identified.",
      "Review REQUEST_TIMESTAMP parsing and LOCATION_NAME values."
    )
  )
}

via_request_data <- via_standardized %>%
