# Reconstruct pooled vehicle trips ----

via_pooling_intervals <- via_extended_requests %>%
  dplyr::filter(
    completed,
    !is.na(request_id),
    request_id != "",
    !is.na(vehicle_id),
    vehicle_id != "",
