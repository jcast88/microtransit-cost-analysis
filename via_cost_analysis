# Time-of-day analysis ----
#
# Time categories match the Circuit analysis:
#   Morning:   7:00 AM-9:59 AM
#   Midday:   10:00 AM-2:59 PM
#   Afternoon: 3:00 PM-6:59 PM
#   Evening:   7:00 PM-11:59 PM
#
# El Cajon operates from 8:00 AM to 5:00 PM.
# Southeastern SD operates from 7:00 AM to 7:00 PM.
# Neither service therefore has scheduled Evening VRHs.

via_time_periods <- tibble::tribble(
  ~time_period, ~period_start_minute, ~period_end_minute,
  "Morning",                    420,                600,
  "Midday",                     600,                900,
  "Afternoon",                  900,               1140,
  "Evening",                   1140,               1440
)


# Calculate scheduled VRHs within each time period.

via_tod_schedule <- via_service_levels_cost %>%
  dplyr::select(
    system,
    vehicles,
    service_start_hour,
    service_end_hour
  ) %>%
  dplyr::mutate(
    service_start_minute =
      service_start_hour * 60,
    
    service_end_minute =
      service_end_hour * 60
  ) %>%
  tidyr::crossing(
    via_time_periods
  ) %>%
  dplyr::mutate(
    overlap_minutes =
      pmax(
        0,
        pmin(
          service_end_minute,
          period_end_minute
        ) -
          pmax(
            service_start_minute,
            period_start_minute
          )
      ),
    
    scheduled_hours_in_period =
      overlap_minutes / 60,
    
    scheduled_vrh_in_period =
      scheduled_hours_in_period *
      vehicles
  ) %>%
  dplyr::filter(
    scheduled_vrh_in_period > 0
  ) %>%
  dplyr::select(
    system,
    time_period,
    scheduled_hours_in_period,
    scheduled_vrh_in_period
  )


