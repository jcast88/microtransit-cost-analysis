# Reconstruct pooled vehicle-trip events

circuit_pooling_intervals <- circuit_extended_requests %>%
  dplyr::filter(
    completed,
    !is.na(request_id),
    request_id != "",
    !is.na(vehicle_id),
    vehicle_id != "",
    !is.na(pickup_timestamp),
    !is.na(dropoff_timestamp),
    dropoff_timestamp >
      pickup_timestamp,
    !is.na(passengers),
    passengers > 0
  ) %>%
  dplyr::mutate(
    service_date =
      as.Date(
        pickup_timestamp,
        tz = "America/Los_Angeles"
      ),
    
    request_key =
      dplyr::row_number(),
    
    pooling_flag =
      dplyr::coalesce(
        pooling_flag,
        FALSE
      )
  ) %>%
  dplyr::select(
    analysis_period,
    system,
    request_key,
    request_id,
    vehicle_id,
    service_date,
    pickup_timestamp,
    dropoff_timestamp,
    passengers,
    pooling_flag
  )


# Identify qualifying pooled pairs:
# same vehicle, same date, at least one minute of overlap,
# and both requests flagged as pooled.

circuit_pooled_pairs <- circuit_pooling_intervals %>%
  dplyr::inner_join(
    circuit_pooling_intervals,
    by = c(
      "analysis_period",
      "system",
      "vehicle_id",
      "service_date"
    ),
    suffix = c(
      "_a",
      "_b"
    ),
    relationship =
      "many-to-many"
  ) %>%
  dplyr::filter(
    request_key_a <
      request_key_b,
    pooling_flag_a,
    pooling_flag_b
  ) %>%
  dplyr::mutate(
    overlap_start =
      pmax(
        pickup_timestamp_a,
        pickup_timestamp_b
      ),
    
    overlap_end =
      pmin(
        dropoff_timestamp_a,
        dropoff_timestamp_b
      ),
    
    overlap_minutes =
      as.numeric(
        difftime(
          overlap_end,
          overlap_start,
          units = "mins"
        )
      )
  ) %>%
  dplyr::filter(
    overlap_minutes >= 1
  )


# Flag both requests in each qualifying pooled pair.

circuit_pooled_request_keys <- dplyr::bind_rows(
  circuit_pooled_pairs %>%
    dplyr::transmute(
      analysis_period,
      system,
      request_key =
        request_key_a
    ),
  
  circuit_pooled_pairs %>%
    dplyr::transmute(
      analysis_period,
      system,
      request_key =
        request_key_b
    )
) %>%
  dplyr::distinct() %>%
  dplyr::mutate(
    reconstructed_pooled =
      TRUE
  )


circuit_requests_with_pooling <- circuit_pooling_intervals %>%
  dplyr::left_join(
    circuit_pooled_request_keys,
    by = c(
      "analysis_period",
      "system",
      "request_key"
    )
  ) %>%
  dplyr::mutate(
    reconstructed_pooled =
      dplyr::coalesce(
        reconstructed_pooled,
        FALSE
      )
  )


# Group continuously overlapping requests into reconstructed ride events.

circuit_ride_events <- circuit_requests_with_pooling %>%
  dplyr::arrange(
    analysis_period,
    system,
    vehicle_id,
    service_date,
    pickup_timestamp,
    dropoff_timestamp
  ) %>%
  dplyr::group_by(
    analysis_period,
    system,
    vehicle_id,
    service_date
  ) %>%
  dplyr::mutate(
    prior_latest_dropoff =
      dplyr::lag(
        cummax(
          as.numeric(
            dropoff_timestamp
          )
        )
      ),
    
    new_ride_event =
      dplyr::if_else(
        is.na(
          prior_latest_dropoff
        ) |
          as.numeric(
            pickup_timestamp
          ) >=
          prior_latest_dropoff,
        1L,
        0L
      ),
    
    ride_event_id =
      cumsum(
        new_ride_event
      )
  ) %>%
  dplyr::ungroup() %>%
  dplyr::group_by(
    analysis_period,
    system,
    vehicle_id,
    service_date,
    ride_event_id
  ) %>%
  dplyr::summarise(
    completed_requests =
      dplyr::n_distinct(
        request_key
      ),
    
    qualifying_pooled_requests =
      sum(
        reconstructed_pooled,
        na.rm = TRUE
      ),
    
    passengers_per_ride =
      sum(
        passengers,
        na.rm = TRUE
      ),
    
    ride_start =
      min(
        pickup_timestamp,
        na.rm = TRUE
      ),
    
    ride_end =
      max(
        dropoff_timestamp,
        na.rm = TRUE
      ),
    
    pooling_status =
      dplyr::if_else(
        completed_requests > 1 &
          qualifying_pooled_requests ==
          completed_requests,
        "Pooled",
        "Non-Pooled"
      ),
    
    .groups = "drop"
  )


# QA: pooled events should contain multiple requests and passengers.

circuit_pooled_ride_qa <- circuit_ride_events %>%
  dplyr::filter(
    pooling_status == "Pooled",
    completed_requests < 2 |
      passengers_per_ride < 2
  )


# AVO for pooled and non-pooled ride events.

circuit_avo_by_pooling <- circuit_ride_events %>%
  dplyr::group_by(
    analysis_period,
    system,
    pooling_status
  ) %>%
  dplyr::summarise(
    completed_rides =
      dplyr::n(),
    
    completed_requests =
      sum(
        completed_requests,
        na.rm = TRUE
      ),
    
    completed_passengers =
      sum(
        passengers_per_ride,
        na.rm = TRUE
      ),
    
    aggregate_avo =
      safe_divide(
        completed_passengers,
        completed_rides
      ),
    
    .groups = "drop"
  ) %>%
  dplyr::group_by(
    analysis_period,
    system
  ) %>%
  dplyr::mutate(
    share_of_completed_rides =
      completed_rides /
      sum(
        completed_rides
      )
  ) %>%
  dplyr::ungroup()


# AVO across all reconstructed ride events.

circuit_avo_all <- circuit_ride_events %>%
  dplyr::group_by(
    analysis_period,
    system
  ) %>%
  dplyr::summarise(
    pooling_status =
      "All Trips",
    
    completed_rides =
      dplyr::n(),
    
    completed_requests =
      sum(
        completed_requests,
        na.rm = TRUE
      ),
    
    completed_passengers =
      sum(
        passengers_per_ride,
        na.rm = TRUE
      ),
    
    aggregate_avo =
      safe_divide(
        completed_passengers,
        completed_rides
      ),
    
    share_of_completed_rides =
      1,
    
    .groups = "drop"
  )


circuit_avo_results <- dplyr::bind_rows(
  circuit_avo_by_pooling,
  circuit_avo_all
) %>%
  dplyr::mutate(
    pooling_status = factor(
      pooling_status,
      levels = c(
        "Non-Pooled",
        "Pooled",
        "All Trips"
      )
    )
  ) %>%
  dplyr::arrange(
    analysis_period,
    pooling_status
  ) %>%
  dplyr::mutate(
    pooling_status =
      as.character(
        pooling_status
      )
  )


# Replace request-level AVO and pooling share in trip characteristics

circuit_trip_characteristics_revised <- trip_characteristics %>%
  dplyr::rename(
    analysis_period =
      period
  ) %>%
  dplyr::select(
    -average_vehicle_occupancy,
    -pooling_share
  ) %>%
  dplyr::left_join(
    circuit_avo_results %>%
      dplyr::filter(
        pooling_status ==
          "All Trips"
      ) %>%
      dplyr::select(
        analysis_period,
        system,
        average_vehicle_occupancy =
          aggregate_avo
      ),
    by = c(
      "analysis_period",
      "system"
    )
  ) %>%
  dplyr::left_join(
    circuit_avo_results %>%
      dplyr::filter(
        pooling_status ==
          "Pooled"
      ) %>%
      dplyr::select(
        analysis_period,
        system,
        pooling_share =
          share_of_completed_rides
      ),
    by = c(
      "analysis_period",
      "system"
    )
  ) %>%
  dplyr::relocate(
    average_vehicle_occupancy,
    pooling_share,
    .after =
      completed_passengers
  )


# Pooling coverage QA

circuit_pooling_coverage_qa <- circuit_extended_requests %>%
  dplyr::filter(
    completed,
    !is.na(passengers),
    passengers > 0
  ) %>%
  dplyr::group_by(
    analysis_period,
    system
  ) %>%
  dplyr::summarise(
    completed_requests =
      dplyr::n(),
    
    requests_with_vehicle_id =
      sum(
        !is.na(vehicle_id) &
          vehicle_id != ""
      ),
    
    requests_with_pickup =
      sum(
        !is.na(
          pickup_timestamp
        )
      ),
    
    requests_with_dropoff =
      sum(
        !is.na(
          dropoff_timestamp
        )
      ),
    
    requests_used_in_pooling_analysis =
      sum(
        !is.na(vehicle_id) &
          vehicle_id != "" &
          !is.na(
            pickup_timestamp
          ) &
          !is.na(
            dropoff_timestamp
          ) &
          dropoff_timestamp >
          pickup_timestamp
      ),
    
    share_used_in_pooling_analysis =
      requests_used_in_pooling_analysis /
      completed_requests,
    
    .groups = "drop"
  )


