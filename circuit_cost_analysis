# Service calendars ----
o_range <- trips %>%
  dplyr::filter(system == "Oceanside") %>%
  dplyr::summarise(
    start = min(request_date),
    end = min(max(request_date), oceanside_end)
  )

oceanside_calendar <- tibble::tibble(
  service_date = seq.Date(
    o_range$start,
    o_range$end,
    by = "day"
  )
) %>%
  dplyr::mutate(
    system = "Oceanside",
    fiscal_year = fy(service_date),
    season = dplyr::if_else(
      lubridate::month(service_date) %in% 5:11,
      "High Season",
      "Low Season"
    ),
    wd = lubridate::wday(
      service_date,
      week_start = 1
    ),
    service_start_hour = dplyr::case_when(
      season == "High Season" & wd %in% 1:3 ~ 12,
      season == "High Season" & wd %in% 4:7 ~ 10,
      season == "Low Season" & wd %in% 3:7 ~ 10,
      TRUE ~ NA_real_
    ),
    service_end_hour = dplyr::case_when(
      !is.na(service_start_hour) ~ 22,
      TRUE ~ NA_real_
    ),
    service_hours = service_end_hour -
      service_start_hour,
    vehicles = dplyr::case_when(
      season == "High Season" ~ 4,
      season == "Low Season" & wd %in% 3:7 ~ 3,
      TRUE ~ 0
    ),
    scheduled_vrh = vehicles * service_hours,
    
    # Contract tiers apply to each vehicle's normal scheduled weekly hours:
    # High season: 3 days x 10 hours + 4 days x 12 hours = 78 hours.
    # Low season: 5 days x 12 hours = 60 hours.
    weekly_vehicle_hours = dplyr::case_when(
      season == "High Season" ~ 78,
      season == "Low Season" ~ 60,
      TRUE ~ NA_real_
    ),
    cost_per_vrh = tier_value(
      weekly_vehicle_hours,
      oceanside_tiers,
      "cost_per_vrh"
    ),
    contract_daily_cost =
      scheduled_vrh * cost_per_vrh,
    week_start = lubridate::floor_date(
      service_date,
      "week",
      week_start = 1
    )
  ) %>%
  dplyr::filter(
    scheduled_vrh > 0
  )

oceanside_contract_qa <- oceanside_calendar %>%
  dplyr::distinct(
    season,
    vehicles,
    weekly_vehicle_hours,
    cost_per_vrh
  ) %>%
  dplyr::mutate(
    expected_weekly_vehicle_hours =
      dplyr::if_else(
        season == "High Season",
        78,
        60
      ),
    expected_rate =
      dplyr::if_else(
        season == "High Season",
        51.90,
        53.91
      ),
    hours_match_expected =
      weekly_vehicle_hours ==
      expected_weekly_vehicle_hours,
    rate_matches_expected =
      abs(cost_per_vrh - expected_rate) < 1e-8
  )

if (
  any(!oceanside_contract_qa$hours_match_expected) ||
  any(!oceanside_contract_qa$rate_matches_expected)
) {
  stop(
    paste(
      "Oceanside contract QA failed.",
      "High-season vehicles should receive the 70-79 hour rate",
      "and low-season vehicles should receive the 60-69 hour rate."
    )
  )
}


