standardize_circuit <- function(df, force_system = NA_character_) {
  service <- as.character(col_or(df, "Service", NA_character_))
  location <- as.character(col_or(df, "LOCATION_NAME", NA_character_))
  req_ts <- parse_timestamp(col_or(df, "REQUEST_TIMESTAMP", NA))
  created_ts <- parse_timestamp(col_or(df, "RIDE_CREATED_TIMESTAMP", NA))
  completion_ts <- parse_timestamp(col_or(df, "DROPOFF_TIMESTAMP", NA))
  
  system <- dplyr::case_when(
    !is.na(force_system) ~ force_system,
    stringr::str_detect(dplyr::coalesce(service, ""), stringr::regex("FRED\\s*-?\\s*San Diego", TRUE)) |
      stringr::str_detect(dplyr::coalesce(location, ""), stringr::regex("FRED\\s*-?\\s*San Diego", TRUE)) ~ "FRED - San Diego",
    stringr::str_detect(dplyr::coalesce(service, ""), stringr::regex("PB Beach Bug|Pacific Beach|Beach Bug", TRUE)) |
      stringr::str_detect(dplyr::coalesce(location, ""), stringr::regex("PB Beach Bug|Pacific Beach|Beach Bug", TRUE)) ~ "PB Beach Bug",
    TRUE ~ NA_character_
  )
  
  tibble::tibble(
    system = system,
    request_timestamp = req_ts,
    request_date = dplyr::coalesce(
      safe_date(col_or(df, "REQUEST_DATE", NA)),
      safe_date(col_or(df, "RIDE_DATE", NA)),
      as.Date(req_ts, tz = "America/Los_Angeles"),
      as.Date(created_ts, tz = "America/Los_Angeles")
    ),
    completion_timestamp = completion_ts,
    passengers = dplyr::coalesce(
      safe_num(col_or(df, "RIDERSHIP_QTY", NA_real_)),
      safe_num(col_or(df, "FLAGDOWN_RIDERSHIP_QTY", NA_real_))
    ),
    completed = flag_1(col_or(df, "IS_COMPLETED_RIDE", NA_real_)),
    trip_minutes = dplyr::coalesce(
      safe_num(col_or(df, "RIDE_TIME_SECONDS", NA_real_)) / 60,
      time_to_seconds(col_or(df, "RIDE_TIME", NA)) / 60
    ),
    wait_minutes = dplyr::coalesce(
      safe_num(col_or(df, "PICKUP_TIME_IN_MINUTES", NA_real_)),
      time_to_seconds(col_or(df, "WAIT_TIME", NA)) / 60,
      safe_num(col_or(df, "DRIVER_ARRIVED_IN_MINUTES", NA_real_))
    ),
    ride_distance_miles = dplyr::coalesce(
      safe_num(col_or(df, "RIDE_DISTANCE_MILES", NA_real_)),
      safe_num(col_or(df, "Ride_Distance", NA_real_)),
      safe_num(col_or(df, "Ride Distance", NA_real_))
    ),
    pooling_flag = flag_1(col_or(df, "IS_POOLING_TAG", NA_real_)),
    ada_flag = flag_1(col_or(df, "IS_RIDES_ADA", NA_real_))
  ) %>%
    dplyr::filter(!is.na(system), !is.na(request_date))
}

