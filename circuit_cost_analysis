    dplyr::filter(observed_day) %>%
    dplyr::group_by(dplyr::across(dplyr::all_of(group_cols))) %>%
    dplyr::summarise(
      first_observed_date = min(service_date),
      last_observed_date = max(service_date),
      observed_days = dplyr::n(),
      mean_daily_passengers = mean(.data$total_passengers),
      min_daily_passengers = mean(.data$total_passengers),
      p25_daily_passengers = quantile_or_na(.data$total_passengers, 0.25),
      median_daily_passengers = median(.data$total_passengers),
      p75_daily_passengers = quantile_or_na(.data$total_passengers, 0.75),
      p90_daily_passengers = quantile_or_na(.data$total_passengers, 0.90),
      max_daily_passengers = max(.data$total_passengers),
      total_passengers = sum(.data$total_passengers),
      .groups = "drop"
    )
}

