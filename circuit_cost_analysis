# Allocate invoice values to scheduled service days ----
#
# Each monthly invoice is divided evenly across all scheduled service days in
# that service-month. Invoice VRH is allocated using the same method.

invoice_daily <- daily %>%
  dplyr::filter(
    !is.na(contract_cost_bin),
    scheduled_service_day
  ) %>%
  dplyr::left_join(
    all_invoices,
    by = c(
      "system",
      "year_month"
    )
  ) %>%
  dplyr::group_by(
    system,
    year_month
  ) %>%
  dplyr::mutate(
    invoice_service_days = dplyr::n(),
    
    invoice_daily_vrh = dplyr::case_when(
      !is.na(
        dplyr::first(invoice_vrh)
      ) ~
        dplyr::first(invoice_vrh) /
        dplyr::first(invoice_service_days),
      
      TRUE ~ NA_real_
    ),
    
    invoice_daily_cost = dplyr::case_when(
      !is.na(
        dplyr::first(invoice_cost)
      ) ~
        dplyr::first(invoice_cost) /
        dplyr::first(invoice_service_days),
      
      TRUE ~ NA_real_
    )
  ) %>%
  dplyr::ungroup() %>%
  dplyr::select(
    system,
    service_date,
    fiscal_year,
    year_month,
    report_bin,
    contract_cost_bin,
    season,
    schedule_period,
    scheduled_service_day,
    observed_day,
    total_passengers,
    invoice_service_days,
    service_expected,
    invoice_vrh,
    invoice_daily_vrh,
    invoice_rate,
    invoice_cost,
    invoice_daily_cost
  ) %>%
  dplyr::arrange(
    system,
    service_date
  )


