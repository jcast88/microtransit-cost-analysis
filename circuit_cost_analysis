#
# Oceanside and FRED use a fixed active fleet throughout each service day.

circuit_fixed_fleet_blocks <- circuit_eligible_service_days %>%
  dplyr::filter(
    system %in% c(
      "Oceanside",
      "FRED - San Diego"
    )
  ) %>%
  dplyr::transmute(
    analysis_period,
    system,
    service_date,
    day_type,
    
    block_start_minute =
      service_start_hour * 60,
    
    block_end_minute =
      service_end_hour * 60,
    
    active_vehicles =
      vehicles
  ) %>%
  dplyr::filter(
    !is.na(block_start_minute),
    !is.na(block_end_minute),
    block_end_minute >
      block_start_minute,
    !is.na(active_vehicles),
    active_vehicles > 0
  )


# PB Beach Bug uses different active fleets within the service day.
#
# The inner join restricts PB blocks to eligible scheduled service dates only.
# Any PB schedule block on a non-service date is removed.

circuit_pb_service_dates <- circuit_eligible_service_days %>%
  dplyr::filter(
    system == "PB Beach Bug"
  ) %>%
  dplyr::select(
    analysis_period,
    system,
    service_date,
    day_type
  ) %>%
  dplyr::distinct()


circuit_pb_time_blocks <- pb_calendar_blocks %>%
  dplyr::filter(
    scheduled_service_day,
    
    !dplyr::coalesce(
      known_non_service_date,
      FALSE
    )
  ) %>%
  dplyr::inner_join(
    circuit_pb_service_dates,
    by = c(
      "system",
      "service_date"
    )
  ) %>%
  dplyr::transmute(
    analysis_period,
    system,
    service_date,
    day_type,
    
    block_start_minute =
      block_start_hour * 60,
    
    block_end_minute =
      block_end_hour * 60,
    
    active_vehicles
  ) %>%
  dplyr::filter(
    !is.na(block_start_minute),
    !is.na(block_end_minute),
    block_end_minute >
      block_start_minute,
    !is.na(active_vehicles),
    active_vehicles > 0
  )


circuit_service_blocks <- dplyr::bind_rows(
  circuit_fixed_fleet_blocks,
  circuit_pb_time_blocks
)


# 4. Calculate scheduled VRHs in each time period

circuit_tod_scheduled_vrh <- tidyr::crossing(
  circuit_service_blocks,
  circuit_time_periods
) %>%
  dplyr::mutate(
    overlap_minutes = pmax(
      0,
      pmin(
        block_end_minute,
        period_end_minute
      ) -
        pmax(
          block_start_minute,
          period_start_minute
        )
    ),
    
    scheduled_vrh =
      overlap_minutes /
      60 *
      active_vehicles
  ) %>%
  dplyr::filter(
    overlap_minutes > 0,
    scheduled_vrh > 0
  ) %>%
  dplyr::group_by(
    analysis_period,
    system,
    service_date,
    day_type,
    time_period
  ) %>%
  dplyr::summarise(
    scheduled_vrh = sum(
      scheduled_vrh,
      na.rm = TRUE
    ),
    
    .groups = "drop"
  )


# 5. Assign completed passengers to time periods
#
# Passenger records are inner-joined to eligible service days. Requests on
# unscheduled days, closures, holidays, or dates outside the report period
# therefore cannot enter the analysis.

circuit_tod_completed <- circuit_extended_requests %>%
  dplyr::filter(
    completed,
    !is.na(passengers),
    passengers > 0,
    !is.na(request_timestamp),
    !is.na(request_date)
  ) %>%
  dplyr::mutate(
    service_date =
      request_date,
    
    request_minute =
      lubridate::hour(
        request_timestamp
      ) *
      60 +
      lubridate::minute(
        request_timestamp
      ),
    
    time_period = dplyr::case_when(
      request_minute >= 420 &
        request_minute < 600 ~
        "Morning",
      
      request_minute >= 600 &
        request_minute < 900 ~
        "Midday",
      
      request_minute >= 900 &
        request_minute < 1140 ~
        "Afternoon",
      
      request_minute >= 1140 &
        request_minute < 1440 ~
        "Evening",
      
      TRUE ~
        NA_character_
    )
  ) %>%
  dplyr::filter(
    !is.na(time_period)
  ) %>%
  dplyr::inner_join(
    circuit_eligible_service_days %>%
      dplyr::select(
        analysis_period,
        system,
        service_date,
        day_type
      ) %>%
      dplyr::distinct(),
    by = c(
      "analysis_period",
      "system",
      "service_date"
    )
  ) %>%
  dplyr::group_by(
    analysis_period,
    system,
    service_date,
    day_type,
    time_period
  ) %>%
  dplyr::summarise(
    completed_requests =
      dplyr::n(),
    
    completed_passengers = sum(
      passengers,
      na.rm = TRUE
    ),
    
    .groups = "drop"
  )


# 6. Calculate daily riders per VRH
#
# Every row in circuit_tod_scheduled_vrh represents an eligible scheduled
# service period. If that period had no completed passengers, it is retained
# as a valid zero-rider observation.

circuit_tod_daily <- circuit_tod_scheduled_vrh %>%
  dplyr::left_join(
    circuit_tod_completed,
    by = c(
      "analysis_period",
      "system",
      "service_date",
      "day_type",
      "time_period"
    )
  ) %>%
  dplyr::mutate(
    completed_requests =
      dplyr::coalesce(
        completed_requests,
        0L
      ),
    
    completed_passengers =
      dplyr::coalesce(
        completed_passengers,
        0
      ),
    
    riders_per_vrh =
      completed_passengers /
      scheduled_vrh,
    
    time_period = factor(
      time_period,
      levels = c(
        "Morning",
        "Midday",
        "Afternoon",
        "Evening"
      )
    )
  ) %>%
  dplyr::filter(
    !is.na(riders_per_vrh),
    is.finite(riders_per_vrh)
  )


# 7. Summarize daily riders per VRH

circuit_tod_summary <- circuit_tod_daily %>%
  dplyr::group_by(
    analysis_period,
    system,
    day_type,
    time_period
  ) %>%
  dplyr::summarise(
    observed_service_days =
      dplyr::n_distinct(
        service_date
      ),
    
    average_riders_per_vrh =
      mean(
        riders_per_vrh,
        na.rm = TRUE
      ),
    
    minimum_riders_per_vrh =
      min(
        riders_per_vrh,
        na.rm = TRUE
      ),
    
    p25_riders_per_vrh =
      as.numeric(
        stats::quantile(
          riders_per_vrh,
          probs = 0.25,
          na.rm = TRUE
        )
      ),
    
    median_riders_per_vrh =
      median(
        riders_per_vrh,
        na.rm = TRUE
      ),
    
    p75_riders_per_vrh =
      as.numeric(
        stats::quantile(
          riders_per_vrh,
          probs = 0.75,
          na.rm = TRUE
        )
      ),
    
    maximum_riders_per_vrh =
      max(
        riders_per_vrh,
        na.rm = TRUE
      ),
    
    total_completed_passengers =
      sum(
        completed_passengers,
        na.rm = TRUE
      ),
    
    total_scheduled_vrh =
      sum(
        scheduled_vrh,
        na.rm = TRUE
      ),
    
    .groups = "drop"
  ) %>%
  dplyr::arrange(
    analysis_period,
    day_type,
    time_period
  ) %>%
  dplyr::mutate(
    time_period =
      as.character(
        time_period
      )
  )


# 8. QA checks

