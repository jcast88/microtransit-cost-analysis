# Helpers ----
col_or <- function(df, nm, default = NA) {
  if (nm %in% names(df)) df[[nm]] else rep(default, nrow(df))
}

safe_num <- function(x) suppressWarnings(as.numeric(x))

flag_1 <- function(x) {
  out <- safe_num(x) == 1
  out[is.na(out)] <- FALSE
  out
}

safe_divide <- function(num, den) {
  n <- max(length(num), length(den))
  num <- rep(num, length.out = n)
  den <- rep(den, length.out = n)
  out <- rep(NA_real_, n)
  ok <- !is.na(num) & !is.na(den) & den != 0
  out[ok] <- num[ok] / den[ok]
  out
}

sum_or_na <- function(x) if (length(x) == 0 || all(is.na(x))) NA_real_ else sum(x, na.rm = TRUE)
mean_or_na <- function(x) if (length(x) == 0 || all(is.na(x))) NA_real_ else mean(x, na.rm = TRUE)
median_or_na <- function(x) if (length(x) == 0 || all(is.na(x))) NA_real_ else median(x, na.rm = TRUE)

quantile_or_na <- function(x, p) {
  x <- x[!is.na(x)]
  if (length(x) == 0) NA_real_ else as.numeric(stats::quantile(x, p, type = 7))
}

safe_date <- function(x) {
  if (inherits(x, "Date")) return(x)
  if (inherits(x, "POSIXct") || inherits(x, "POSIXt")) return(as.Date(x, tz = "America/Los_Angeles"))
  if (is.numeric(x)) return(as.Date(x, origin = "1899-12-30"))
  x <- stringr::str_trim(as.character(x))
  x[x == ""] <- NA_character_
  dplyr::coalesce(
    suppressWarnings(lubridate::ymd(x, quiet = TRUE)),
    suppressWarnings(lubridate::mdy(x, quiet = TRUE)),
    suppressWarnings(lubridate::dmy(x, quiet = TRUE))
  )
}

parse_timestamp <- function(x, tz = "America/Los_Angeles") {
  # Circuit source timestamps are local clock times. If readr has already
  # parsed a timezone-free field as POSIXct, force the intended timezone
  # without shifting the displayed clock time.
  if (inherits(x, "POSIXct") || inherits(x, "POSIXt")) {
    return(lubridate::force_tz(x, tzone = tz))
  }
  
  x <- stringr::str_trim(as.character(x))
  x[x == ""] <- NA_character_
  suppressWarnings(lubridate::parse_date_time(
    x,
    orders = c("Y-m-d H:M:S", "Y-m-d H:M", "m/d/Y H:M:S", "m/d/Y H:M",
               "m/d/Y I:M:S p", "m/d/Y I:M p"),
    tz = tz,
    quiet = TRUE
  ))
}

time_to_seconds <- function(x) {
  if (inherits(x, "hms") || inherits(x, "difftime")) return(as.numeric(x, units = "secs"))
  if (is.numeric(x)) return(as.numeric(x))
  suppressWarnings(as.numeric(hms::as_hms(as.character(x))))
}

fy <- function(date) dplyr::if_else(lubridate::month(date) >= 7, lubridate::year(date) + 1L, lubridate::year(date))

hour_label <- function(x) {
  labels <- format(
    as.POSIXct(
      paste0(
        "2000-01-01 ",
        sprintf("%02d", x),
        ":00:00"
      ),
      tz = "America/Los_Angeles"
    ),
    "%I %p"
  )
  
  sub("^0", "", labels)
}

tier_value <- function(vrh, tiers, value_col) {
  out <- rep(NA_real_, length(vrh))
  for (i in seq_len(nrow(tiers))) {
    hit <- vrh >= tiers$vrh_min[i] & vrh <= tiers$vrh_max[i]
    out[hit] <- tiers[[value_col]][i]
  }
  out
}


